{
  "name": "@passage/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run build:public-assets",
    "build:public-assets": "esbuild public-assets/mermaid.ts --bundle --format=esm --minify --outfile=out/assets/public-mermaid.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "isomorphic-dompurify": "^3.20.0",
    "marked": "^18.0.7",
    "mermaid": "11.16.1",
    "next": "^16.3.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "esbuild": "0.28.1",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.2.12",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
