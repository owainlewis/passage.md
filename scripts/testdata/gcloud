#!/usr/bin/env bash
set -euo pipefail

printf '%s\n' "$*" >>"${PASSAGE_GCLOUD_LOG:?}"

if [[ "${PASSAGE_FAIL_MIGRATION:-false}" == "true" && "$*" == "run jobs execute "* ]]; then
  exit 1
fi

if [[ "${PASSAGE_EMPTY_REVISION:-false}" != "true" && "$*" == "run deploy "* ]]; then
  printf '%s\n' "${PASSAGE_DEPLOYED_REVISION:-passage-test-00001-test}"
fi

if [[ "$*" == "run revisions describe "* ]]; then
  if [[ -n "${PASSAGE_REVISION_STATE_SEQUENCE:-}" ]]; then
    revision_ready_count=0
    if [[ -f "${PASSAGE_REVISION_READY_COUNTER_FILE:?}" ]]; then
      revision_ready_count="$(<"${PASSAGE_REVISION_READY_COUNTER_FILE}")"
    fi
    revision_ready_count=$((revision_ready_count + 1))
    printf '%s\n' "${revision_ready_count}" >"${PASSAGE_REVISION_READY_COUNTER_FILE}"

    IFS=';' read -r -a revision_ready_sequence <<<"${PASSAGE_REVISION_STATE_SEQUENCE}"
    revision_ready_index=$((revision_ready_count - 1))
    if ((revision_ready_index >= ${#revision_ready_sequence[@]})); then
      revision_ready_index=$((${#revision_ready_sequence[@]} - 1))
    fi
    printf '%s\n' "${revision_ready_sequence[revision_ready_index]}"
  else
    printf '%s\n' "${PASSAGE_REVISION_STATE:-1,1,True}"
  fi
fi
