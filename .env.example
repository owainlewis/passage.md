DATABASE_URL=postgres://localhost:5432/passage_dev?sslmode=disable
PASSAGE_DATABASE_MAX_CONNS=3
PORT=3000
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=dev-session-secret-change-me

# Emergency recovery fence. When true, the server rejects all mutation methods.
PASSAGE_WRITES_DISABLED=false

# Public account creation is a launch gate. Keep false until explicit go-live approval.
PASSAGE_PUBLIC_SIGNUP_ENABLED=false

# Leave both Resend values empty to log reset links during local development.
RESEND_API_KEY=
RESEND_FROM=

# Abuse limits use fixed windows. Set requests to 0 to disable a class locally.
PASSAGE_RATE_LIMIT_AUTH_REQUESTS=20
PASSAGE_RATE_LIMIT_AUTH_WINDOW=1m
PASSAGE_RATE_LIMIT_DOCUMENT_MUTATION_REQUESTS=120
PASSAGE_RATE_LIMIT_DOCUMENT_MUTATION_WINDOW=1m
PASSAGE_RATE_LIMIT_DOCUMENT_SEARCH_REQUESTS=120
PASSAGE_RATE_LIMIT_DOCUMENT_SEARCH_WINDOW=1m
PASSAGE_RATE_LIMIT_API_TOKEN_REQUESTS=30
PASSAGE_RATE_LIMIT_API_TOKEN_WINDOW=1m
PASSAGE_RATE_LIMIT_SHARED_HTML_REQUESTS=120
PASSAGE_RATE_LIMIT_SHARED_HTML_WINDOW=1m
PASSAGE_RATE_LIMIT_RAW_MARKDOWN_REQUESTS=240
PASSAGE_RATE_LIMIT_RAW_MARKDOWN_WINDOW=1m

# Leave empty locally. Production defaults are set for the Cloud Run proxy path.
PASSAGE_TRUSTED_PROXY_CIDRS=
PASSAGE_FORWARDED_HOPS=0
