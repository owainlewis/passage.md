{
  "name": "passage.md",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "./scripts/dev.sh",
    "dev:web": "npm run dev -w @passage/web -- --port 3001",
    "build:web": "npm run build -w @passage/web",
    "lint": "npm run lint -w @passage/web",
    "postinstall": "node scripts/patch-brace-expansion-commonjs.cjs",
    "typecheck": "npm run typecheck -w @passage/web",
    "test": "node scripts/patch-brace-expansion-commonjs.test.cjs && npm run test -w @passage/web"
  },
  "devDependencies": {
    "brace-expansion": "5.0.8"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "brace-expansion": "$brace-expansion",
    "postcss@8.4.31": "8.5.24",
    "sharp@0.34.5": "0.35.3"
  }
}
